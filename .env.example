# Optional. When set, lib/solutions/generate.ts calls the live Anthropic
# API to draft each fix; when unset, it falls back to the deterministic
# template generator. Never expose this to the browser — it's only read
# from server components / route handlers.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-6.
ANTHROPIC_MODEL=

# Optional. When set, lib/questions/index.ts calls Voyage AI (Anthropic's
# recommended embeddings provider) for semantic question-coverage
# scoring; when unset, it falls back to a keyword-overlap heuristic.
# Never exposed to the browser — see app/api/projects/[id]/questions/route.ts,
# which is the seam the client-side "add a question" flow calls through.
VOYAGE_API_KEY=

# Optional. Defaults to voyage-3.5-lite.
VOYAGE_MODEL=

# Required once prisma/schema.prisma is wired up (see architecture.md
# section 9, item 2). Not read by the app yet.
DATABASE_URL=
